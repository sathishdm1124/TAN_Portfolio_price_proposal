<script>
/* ══ CURSOR ══ */
const cur=document.getElementById('cur'),ring=document.getElementById('cur-ring');
let mx=0,my=0,rx=0,ry=0;
document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;cur.style.left=mx+'px';cur.style.top=my+'px';});
function animRing(){rx+=(mx-rx)*.12;ry+=(my-ry)*.12;ring.style.left=rx+'px';ring.style.top=ry+'px';requestAnimationFrame(animRing);}
animRing();
document.querySelectorAll('a,button,.svc,.proj-card,.c-logo,.pkg,.hbox').forEach(el=>{
  el.addEventListener('mouseenter',()=>{cur.classList.add('cur-big');ring.classList.add('cur-ring-big');});
  el.addEventListener('mouseleave',()=>{cur.classList.remove('cur-big');ring.classList.remove('cur-ring-big');});
});

/* ══ PROGRESS BAR ══ */
const prog=document.getElementById('prog');
window.addEventListener('scroll',()=>{
  const pct=(window.scrollY/(document.body.scrollHeight-window.innerHeight))*100;
  prog.style.width=pct+'%';
});

/* ══ BACK TO TOP ══ */
const btt=document.getElementById('btt');
window.addEventListener('scroll',()=>btt.classList.toggle('show',window.scrollY>500));

/* ══ CANVAS BG ══ */
(function(){
  const c=document.getElementById('bgc'),ctx=c.getContext('2d');
  let W,H,pts=[],mx=window.innerWidth/2,my=window.innerHeight/2;
  function resize(){W=c.width=window.innerWidth;H=c.height=window.innerHeight;}
  resize();window.addEventListener('resize',resize);
  document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;});

  // Click burst
  const bursts=[];
  document.addEventListener('click',e=>{
    for(let i=0;i<12;i++){
      const angle=Math.random()*Math.PI*2,speed=Math.random()*4+2;
      bursts.push({x:e.clientX,y:e.clientY,vx:Math.cos(angle)*speed,vy:Math.sin(angle)*speed,life:1,size:Math.random()*5+2});
    }
    ripples.push({x:e.clientX,y:e.clientY,r:0,a:.7});
  });
  const ripples=[];

  class Pt{
    constructor(){this.reset();}
    reset(){
      this.x=Math.random()*W; this.y=Math.random()*H;
      this.sz=Math.random()*2.5+.5;
      this.vx=(Math.random()-.5)*.5; this.vy=(Math.random()-.5)*.5;
      this.life=0; this.maxLife=Math.random()*.5+.3;
      this.col=Math.random()>.45?'#FFD600':'#222222';
    }
    update(){
      this.x+=this.vx; this.y+=this.vy;
      const dx=mx-this.x,dy=my-this.y,d=Math.sqrt(dx*dx+dy*dy);
      if(d<180){this.x+=dx*.006;this.y+=dy*.006;}
      this.life+=.0025;
      if(this.x<0||this.x>W||this.y<0||this.y>H||this.life>this.maxLife)this.reset();
    }
    draw(){
      const a=Math.sin((this.life/this.maxLife)*Math.PI)*.55;
      ctx.save();ctx.globalAlpha=a;ctx.fillStyle=this.col;
      ctx.beginPath();ctx.arc(this.x,this.y,this.sz,0,Math.PI*2);ctx.fill();
      ctx.restore();
    }
  }

  for(let i=0;i<160;i++)pts.push(new Pt());

  function connections(){
    for(let i=0;i<pts.length;i++){
      for(let j=i+1;j<pts.length;j++){
        const dx=pts[i].x-pts[j].x,dy=pts[i].y-pts[j].y,d=Math.sqrt(dx*dx+dy*dy);
        if(d<110){
          ctx.save();ctx.globalAlpha=(1-d/110)*.1;
          ctx.strokeStyle='#FFD600';ctx.lineWidth=.7;
          ctx.beginPath();ctx.moveTo(pts[i].x,pts[i].y);ctx.lineTo(pts[j].x,pts[j].y);ctx.stroke();
          ctx.restore();
        }
      }
    }
    // Mouse connections
    pts.forEach(p=>{
      const dx=mx-p.x,dy=my-p.y,d=Math.sqrt(dx*dx+dy*dy);
      if(d<140){
        ctx.save();ctx.globalAlpha=(1-d/140)*.2;
        ctx.strokeStyle='#FFD600';ctx.lineWidth=1;
        ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(mx,my);ctx.stroke();
        ctx.restore();
      }
    });
  }

  // Floating geometric shapes
  const geos=[
    {x:W*.2,y:H*.3,r:40,speed:.4,phase:0,col:'rgba(255,214,0,0.06)'},
    {x:W*.8,y:H*.2,r:60,speed:.3,phase:1,col:'rgba(255,214,0,0.04)'},
    {x:W*.5,y:H*.7,r:30,speed:.5,phase:2,col:'rgba(0,0,0,0.03)'},
    {x:W*.1,y:H*.8,r:50,speed:.35,phase:.5,col:'rgba(255,214,0,0.05)'},
    {x:W*.9,y:H*.6,r:45,speed:.45,phase:1.5,col:'rgba(0,0,0,0.025)'},
  ];

  let t=0;
  function drawGeos(){
    t+=.008;
    geos.forEach(g=>{
      const y=g.y+Math.sin(t*g.speed+g.phase)*30;
      const x=g.x+Math.cos(t*g.speed*.7+g.phase)*15;
      ctx.save();
      ctx.fillStyle=g.col;
      // Hexagon
      ctx.beginPath();
      for(let i=0;i<6;i++){
        const a=i*Math.PI/3+t*0.2;
        i===0?ctx.moveTo(x+g.r*Math.cos(a),y+g.r*Math.sin(a)):ctx.lineTo(x+g.r*Math.cos(a),y+g.r*Math.sin(a));
      }
      ctx.closePath();ctx.fill();ctx.restore();
    });
  }

  function frame(){
    ctx.clearRect(0,0,W,H);
    drawGeos();
    pts.forEach(p=>{p.update();p.draw();});
    connections();
    // Bursts
    for(let i=bursts.length-1;i>=0;i--){
      const b=bursts[i];
      ctx.save();ctx.globalAlpha=b.life*.8;ctx.fillStyle='#FFD600';
      ctx.beginPath();ctx.arc(b.x,b.y,b.size,0,Math.PI*2);ctx.fill();
      ctx.restore();
      b.x+=b.vx;b.y+=b.vy;b.vx*=.94;b.vy*=.94;b.life-=.04;
      if(b.life<=0)bursts.splice(i,1);
    }
    // Ripples
    for(let i=ripples.length-1;i>=0;i--){
      const rp=ripples[i];
      ctx.save();ctx.globalAlpha=rp.a;ctx.strokeStyle='#FFD600';ctx.lineWidth=2.5;
      ctx.beginPath();ctx.arc(rp.x,rp.y,rp.r,0,Math.PI*2);ctx.stroke();
      // Inner ripple
      ctx.globalAlpha=rp.a*.5;ctx.lineWidth=1;
      ctx.beginPath();ctx.arc(rp.x,rp.y,rp.r*.6,0,Math.PI*2);ctx.stroke();
      ctx.restore();
      rp.r+=5;rp.a-=.022;
      if(rp.a<=0)ripples.splice(i,1);
    }
    requestAnimationFrame(frame);
  }
  frame();
})();

/* ══ TYPED TEXT ══ */
(function(){
  const words=['Social Media Marketing','Meta Ads Campaigns','SEO Optimization','Lead Generation','Business Growth','Branding & Promotions','Google Ads','AI Image Creation'];
  let wi=0,ci=0,del=false,el=document.getElementById('typed');
  function type(){
    const w=words[wi];
    if(!del){el.textContent=w.slice(0,ci+1);ci++;if(ci===w.length){del=true;setTimeout(type,1400);return;}}
    else{el.textContent=w.slice(0,ci-1);ci--;if(ci===0){del=false;wi=(wi+1)%words.length;}}
    setTimeout(type,del?55:90);
  }
  type();
})();

/* ══ COUNTER ══ */
(function(){
  const obs=new IntersectionObserver(entries=>{
    entries.forEach(e=>{
      if(e.isIntersecting){
        document.querySelectorAll('.stat-num').forEach(el=>{
          const target=+el.dataset.target,suffix=el.dataset.suffix||'';
          let cur=0;const inc=target/70;
          const t=setInterval(()=>{cur+=inc;if(cur>=target){cur=target;clearInterval(t);}el.textContent=Math.floor(cur)+suffix;},28);
        });
        obs.disconnect();
      }
    });
  },{threshold:.5});
  const hs=document.querySelector('.hero-stats');
  if(hs)obs.observe(hs);
})();

/* ══ SCROLL REVEAL ══ */
const fObs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');}});
},{threshold:.08});
document.querySelectorAll('.fi,.fi-l,.fi-r,.fi-s').forEach(el=>fObs.observe(el));

/* ══ SERVICE CARDS STAGGER ══ */
const sObs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('sv-in');});
},{threshold:.1});
document.querySelectorAll('.svc').forEach(el=>sObs.observe(el));

/* ══ TOGGLE SERVICE ══ */
function toggleSvc(el){
  const open=el.classList.contains('open');
  document.querySelectorAll('.svc').forEach(s=>s.classList.remove('open'));
  if(!open)el.classList.add('open');
}

/* ══ MOBILE NAV ══ */
function toggleMenu(){document.getElementById('navLinks').classList.toggle('open');}
document.querySelectorAll('.nav-links a').forEach(a=>a.addEventListener('click',()=>document.getElementById('navLinks').classList.remove('open')));

/* ══ ACTIVE NAV ══ */
const navLinks=document.querySelectorAll('.nav-links a');
window.addEventListener('scroll',()=>{
  let cur='';
  document.querySelectorAll('section[id]').forEach(s=>{if(window.scrollY>=s.offsetTop-90)cur=s.id;});
  navLinks.forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+cur));
  document.getElementById('navbar').classList.toggle('scrolled',window.scrollY>50);
});

/* ══ LIGHTBOX ══ */
const imgs=["data:image/png;base64,","data:image/png;base64,","data:image/png;base64,","data:image/png;base64,","data:image/png;base64,","data:image/png;base64,","data:image/png;base64,","data:image/png;base64,","data:image/png;base64,","data:image/png;base64,","data:image/png;base64,","data:image/png;base64,","data:image/png;base64,","data:image/png;base64,","data:image/png;base64,","data:image/png;base64,","data:image/png;base64,"];
const titles=["S6 Wellness – SEO Traffic Dashboard","S6 Wellness – SEO Score 85/100","S6 Wellness – Performance Metrics","S6 Wellness – Lead Generation Overview","S6 Wellness – Google Search Console","S6 Wellness – Facebook Ads Campaign","OSR Builders – Meta Ads Performance","Villa Engagement – Campaign Results","D-Light IL – Lead Generation Ads","Aarav Construction – Messaging Campaigns","Aarav Construction – Lead Campaigns","D-Light IL – Ads Performance","Aarav Construction – Campaign Manager","S6 Wellness – Instagram (1.2M Views)","S6 Wellness – Facebook (5M Views)","S6 Wellness – Instagram Results","S6 Wellness – Full Ads Report"];
let lbi=0;
function openLB(i){
  lbi=i;
  document.getElementById('lb-img').src=imgs[lbi];
  document.getElementById('lb-count').textContent=(lbi+1)+' / '+imgs.length+' — '+titles[lbi];
  document.getElementById('lb').classList.add('on');
  document.body.style.overflow='hidden';
}
function closeLB(){document.getElementById('lb').classList.remove('on');document.body.style.overflow='';}
function lbNav(d){lbi=(lbi+d+imgs.length)%imgs.length;document.getElementById('lb-img').src=imgs[lbi];document.getElementById('lb-count').textContent=(lbi+1)+' / '+imgs.length+' — '+titles[lbi];}
document.getElementById('lb').addEventListener('click',function(e){if(e.target===this)closeLB();});
document.addEventListener('keydown',e=>{
  if(e.key==='Escape')closeLB();
  if(e.key==='ArrowLeft')lbNav(-1);
  if(e.key==='ArrowRight')lbNav(1);
});

/* ══ NAVBAR SCROLL ══ */
window.addEventListener('scroll',()=>{
  document.getElementById('navbar').classList.toggle('scrolled',window.scrollY>40);
});
</script>
</body>
</html>
