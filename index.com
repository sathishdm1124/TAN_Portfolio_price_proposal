          <span class="pkg-tag">Conversion Optimization</span>
        </div>
        <div class="pkg-sup"><p>📞 Weekly Review Call &nbsp;|&nbsp; 👤 Dedicated Campaign Manager</p></div>
        <a href="#contact" class="pkg-cta">Get Started</a>
      </div>

      <div class="pkg fi-r">
        <div class="pkg-name">Premium Business Growth Plan</div>
        <div class="pkg-suit">Suitable For: Real Estate, Clinics, Salons, E-commerce, Premium Service Businesses</div>
        <div class="pkg-price"><sup>₹</sup>50,000<sub> / 3 Months</sub></div>
        <div class="pkg-div"></div>
        <div class="pkg-st">Meta Ads Management</div>
        <ul class="pkg-list">
          <li>Facebook, Instagram &amp; WhatsApp Ads</li>
          <li>Advanced Audience, Custom &amp; Lookalike Setup</li>
          <li>Retargeting &amp; Conversion Campaigns</li>
        </ul>
        <div class="pkg-st">Google Ads Management</div>
        <ul class="pkg-list">
          <li>Search Ads, Call Ads, Local Business Ads</li>
          <li>Keyword Research, Competitor Analysis, Ad Copy</li>
        </ul>
        <div class="pkg-st">Creative Design</div>
        <ul class="pkg-list">
          <li>12 Premium Creatives / Month (36 Total)</li>
          <li>AI Posters, Offer Banners, Festival Creatives</li>
        </ul>
        <div class="pkg-st">Lead Generation + SEO Bonus</div>
        <ul class="pkg-list">
