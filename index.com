      </div>

    </div>
  </div>
</section>

<!-- ══ CLIENTS ══ -->
<section id="clients">
  <div class="container">
    <div class="fi">
      <div class="sec-label">Trusted By</div>
      <h2 class="sec-title">OUR <span>CLIENTS</span></h2>
      <p class="sec-desc">Proud to have partnered with 19+ businesses across multiple industries.</p>
    </div>
  </div>
  <div class="c-rows">
    <div class="c-row"><div class="c-track r1">
      <div class="c-logo"><img src="data:image/jpeg;base64," alt="client" loading="lazy"></div>
      <div class="c-logo"><img src="data:image/jpeg;base64," alt="client" loading="lazy"></div>
